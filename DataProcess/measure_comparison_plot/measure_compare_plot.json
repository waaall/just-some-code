    "output_filename_template": "{data_label}_comparison_result.png",
    "value_format": ".2f",

    "figsize": [20, 6],
    "data_min": null,
    "data_max": null,
    "time_min": 0.0,
    "time_max": null,
    "output_style": "both",
    "input_color": "#1f77b4",
    "output_color": "#ff7f0e",
    "output_marker_size": 1,
    "enable_cursor": true,
    "dpi": 300,
    "output_filename": "../../Tests/4-20mA测试/DEWE高精度测试/ma_comparison_result.png"
  },

  "save_static": true,
  "show_interactive": true
