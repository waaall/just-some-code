      "scale_factor": 1.0
    },
    "output_column": {
      "name": null,
      "index": 1,
      "scale_factor": 1.0
    }
  },

  "alignment_config": {
    "change_threshold": 0.04,
    "threshold_unit": "mA",
    "manual_time_offset_ms": 6300
