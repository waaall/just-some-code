# 多阶段构建版本 - 更小的最终镜像
# 构建阶段
FROM gcc:13 as builder

WORKDIR /app

# 复制源代码
COPY cpp_temp/ .

# 编译程序（静态链接以减少依赖）
RUN make clean && make static

# 运行阶段 - 使用更小的基础镜像
FROM alpine:3.21

# # 安装必要的运行时工具
# RUN apk add --no-cache \
#     net-tools

WORKDIR /app

# 从构建阶段复制编译好的程序
COPY --from=builder /app/system_monitor .

# # 暴露端口（如果需要）
# EXPOSE 9906

# 运行程序
CMD ["./system_monitor"]